# =============================================================================
# Apuni Sarkar — Root .gitignore
# Generated for final GitHub push. Secrets, dependencies, and build outputs
# are intentionally excluded. Copy .env.example to .env locally and fill in
# your own values; never commit real credentials.
# =============================================================================

# --- macOS ---
.DS_Store
*.DS_Store

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment variables (SECRETS — do not commit real values) ---
.env
.env.*
!.env.example

# --- Build / dist outputs ---
dist/
build/
*.tgz

# --- Expo ---
.expo/
web-build/
expo-env.d.ts

# --- Metro ---
.metro-health-check*

# --- Native (generated via CNG — never commit ios/android) ---
.ios/
.android/
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# --- IDE / editor (personal, not part of the project) ---
.vscode/
.idea/
.claude/

# --- TypeScript ---
*.tsbuildinfo

# --- Misc ---
example
node_modules/
.env
