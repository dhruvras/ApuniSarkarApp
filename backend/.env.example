# Backend environment variables — copy this file to .env and fill in your own values.
# Never commit real credentials to version control.

PORT=5001

# MongoDB connection string
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/apuniSarkar?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Brevo (transactional email)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Apuni Sarkar 2.0

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173
